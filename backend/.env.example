# Copy to backend/.env and fill in. Never commit backend/.env: it holds your own secrets.
#   cp .env.example .env

# --- required: the app won't start without these ---------------------------------------------------------------

# Local Postgres from docker-compose. Inside Docker the host is "postgres", not "localhost".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/biletflow

# Signs login tokens. Make your own, never share it, and use a different one on every server:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-your-own-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- optional: the values shown are the defaults -----------------------------------------------------------------

# How long a paid checkout holds its tickets, and how often expired holds are released.
ORDER_HOLD_MINUTES=10
ORDER_SWEEP_INTERVAL_SECONDS=60

# The web app's address: Campaign QR links (and email links) point here. Use the HTTPS address once deployed.
FRONTEND_URL=http://localhost:5173

# Web app addresses allowed to call the API from a browser, comma-separated. Mobile apps don't need this.
CORS_ORIGINS=http://localhost:5173

# Event images: S3-compatible storage. Locally the "storage" service in docker-compose (docker compose up -d storage);
# these keys match it. Leave S3_ENDPOINT_URL empty and image uploads answer 503, everything else works.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=biletflow
S3_SECRET_KEY=biletflow-dev-secret
S3_BUCKET=biletflow-images
S3_REGION=us-east-1
# Only when browsers reach storage at another address than the API does (Docker, a CDN). Default: endpoint/bucket.
# S3_PUBLIC_URL=http://localhost:9000/biletflow-images

# Emails. Without SMTP_HOST nothing is sent: emails wait in the email_outbox table (tests rely on that).
# Locally, Mailpit from docker-compose catches everything; open http://localhost:8025 to read it.
# SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=BiletFlow <no-reply@biletflow.local>
EMAIL_SEND_INTERVAL_SECONDS=5
